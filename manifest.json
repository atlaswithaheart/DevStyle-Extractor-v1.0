{
  "manifest_version": 3,
  "name": "DevStyle Extractor",
  "version": "1.0",
  "description": "Inspect elements on any page and copy clean, ready-to-use CSS.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
